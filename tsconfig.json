{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@app/*": ["app/*"],
      "@components/*": ["app/components/*"],
      "@pages/*": ["app/pages/*"],
      "@features/*": ["features/*"],
      "@shared/*": ["shared/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@api/*": ["infrastructure/api/*"],
      "@sync/*": ["infrastructure/sync/*"],
      "@store/*": ["store/*"],
      "@assets/*": ["assets/*"],
      "@utils/*": ["shared/utils/*"]
    }
  },
  "include": ["src", "types"]
}
